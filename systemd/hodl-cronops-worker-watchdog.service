[Unit]
Description=Ensure HODL CronOps lane workers are running
After=network-online.target pm2-ubuntu.service
Wants=network-online.target pm2-ubuntu.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/monitoring
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PM2_HOME=/home/ubuntu/.pm2
UMask=0077
TimeoutStartSec=2min
ExecStart=/home/ubuntu/monitoring/bin/ensure-hodl-cronops-workers.sh
